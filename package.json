{
  "name": "@cian-ai/open-protocol",
  "version": "0.1.0-alpha.25",
  "packageManager": "pnpm@11.19.0",
  "description": "Reference implementation of Cian's language-to-compute protocol",
  "type": "module",
  "private": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./profiles/*": "./profiles/*",
    "./schemas/*": "./schemas/*",
    "./conformance/*": "./conformance/*"
  },
  "files": [
    "src/",
    "types/",
    "profiles/",
    "schemas/",
    "conformance/",
    "evaluation/cy-v0.1.seed.jsonl",
    "evaluation/cy-v0.2.seed.jsonl",
    "evaluation/cy-v0.2.reviews.example.jsonl",
    "review-ui/",
    "public/",
    "release/",
    "assurance/",
    "database/",
    "openapi/",
    "scripts/validate-openapi.mjs",
    "scripts/check-public-alpha.mjs",
    "scripts/scan-secrets.mjs",
    "docs/developer-quickstart.md",
    "docs/milestone-15.md",
    "docs/milestone-16.md",
    "docs/milestone-17.md",
    "docs/milestone-18.md",
    "docs/milestone-19.md",
    "docs/milestone-20.md",
    "docs/milestone-21.md",
    "docs/milestone-22.md",
    "docs/milestone-23.md",
    "docs/provider-operator-guide.md",
    "docs/threat-model.md",
    "examples/third-party-agent.mjs",
    "examples/prepare-welsh-review.mjs",
    "examples/welsh-review-cockpit.mjs",
    "examples/compute-pool-demo.mjs",
    "examples/external-compute-provider-demo.mjs",
    "examples/postgres-compute-restart-demo.mjs",
    "examples/multi-provider-compute-demo.mjs",
    "examples/provider-onboarding-demo.mjs",
    "examples/compute-operations-demo.mjs",
    "examples/compute-security-demo.mjs",
    "examples/provider-profile.example.json",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euros-cian/cian-open-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/euros-cian/cian-open-protocol/issues"
  },
  "homepage": "https://github.com/euros-cian/cian-open-protocol#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:postgres": "node --test test/postgres.integration.test.js",
    "check": "node --test",
    "demo": "node examples/two-agent-demo.mjs",
    "demo:proof": "node examples/language-proof-demo.mjs",
    "demo:live-agent": "node examples/live-openai-agent.mjs",
    "demo:pilot": "node examples/persistent-pilot-agent.mjs",
    "demo:pilot-api": "node examples/persistent-pilot-api.mjs",
    "setup:validator-trust": "node examples/setup-validator-trust.mjs",
    "demo:validator": "node examples/independent-validator.mjs",
    "eval:welsh": "node examples/evaluate-welsh-profile.mjs",
    "demo:governance": "node examples/appeal-governance.mjs",
    "demo:cockpit-preview": "node examples/cockpit-preview.mjs",
    "eval:welsh:v2": "node examples/evaluate-welsh-v2.mjs",
    "review:welsh:prepare": "node examples/prepare-welsh-review.mjs",
    "review:welsh:cockpit": "node examples/welsh-review-cockpit.mjs",
    "conformance": "node conformance/run.mjs",
    "pack:check": "pnpm pack --dry-run",
    "demo:third-party-agent": "node examples/third-party-agent.mjs",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "release:check": "node scripts/check-public-alpha.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "demo:compute-pool": "node examples/compute-pool-demo.mjs",
    "demo:compute-provider": "node examples/external-compute-provider-demo.mjs",
    "demo:compute-restart": "node examples/postgres-compute-restart-demo.mjs",
    "demo:multi-provider": "node examples/multi-provider-compute-demo.mjs",
    "demo:provider-onboarding": "node examples/provider-onboarding-demo.mjs",
    "demo:compute-operations": "node examples/compute-operations-demo.mjs",
    "demo:compute-security": "node examples/compute-security-demo.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
