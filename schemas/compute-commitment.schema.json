{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.cian.ai/schemas/compute-commitment.schema.json",
  "type": "object",
  "required": ["protocol_version", "commitment_id", "provider_id", "resource_class", "nominal_capacity", "available_from", "available_until", "assurance_ppm", "availability_ppm", "reserve_ppm", "redemption_endpoint", "signature"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "commitment_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "resource_class": { "type": "string", "minLength": 1 },
    "nominal_capacity": { "type": "integer", "minimum": 1 },
    "available_from": { "type": "string", "format": "date-time" },
    "available_until": { "type": "string", "format": "date-time" },
    "assurance_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "availability_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "reserve_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "redemption_endpoint": { "type": "string", "format": "uri" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "additionalProperties": false
}
