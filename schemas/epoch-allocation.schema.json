{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.cian.ai/schemas/epoch-allocation.schema.json",
  "type": "object",
  "required": ["protocol_version", "epoch_id", "series_id", "language_profile", "budget", "accepted_proof_count", "total_weight", "allocated_total", "allocations", "closed_at", "status", "signature"],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "epoch_id": { "type": "string", "minLength": 1 },
    "series_id": { "type": "string", "minLength": 1 },
    "language_profile": { "type": "string", "minLength": 1 },
    "budget": { "type": "integer", "minimum": 0 },
    "accepted_proof_count": { "type": "integer", "minimum": 1 },
    "total_weight": { "type": "integer", "minimum": 1 },
    "allocated_total": { "type": "integer", "minimum": 0 },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proof_id", "recipient_agent_id", "amount"],
        "properties": {
          "proof_id": { "type": "string", "minLength": 1 },
          "recipient_agent_id": { "type": "string", "minLength": 1 },
          "amount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "closed_at": { "type": "string", "format": "date-time" },
    "status": { "const": "final" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "additionalProperties": false
}
